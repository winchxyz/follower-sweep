{
  "manifest_version": 3,
  "name": "Sweep: follower cleanup for X",
  "short_name": "Sweep",
  "version": "0.3.0",
  "description": "Finds followers without a checkmark and under 5,000 followers with the official X API, and marks them on your Followers page.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open Sweep", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "app.html", "open_in_tab": true },
  "permissions": ["storage", "unlimitedStorage", "identity"],
  "host_permissions": ["https://api.x.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
